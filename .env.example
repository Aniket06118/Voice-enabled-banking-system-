# Copy this file to ".env" and fill it in. NEVER commit ".env" or share it publicly.

# Neon connection string (Neon dashboard -> Connect -> copy the connection string).
# Leave this line out entirely to use a local SQLite file instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

DJANGO_SECRET_KEY=change-me-to-any-long-random-text
DJANGO_DEBUG=1

# Gemini key for the voice agent (same key your friend uses in his .env,
# or make a free one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Main model for the assistant, and the backup tried automatically if the main one
# is overloaded (503) or slow. Gemini 2.5 models are no longer open to new projects.
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_FALLBACK_MODEL=gemini-3.5-flash-lite
# Model that checks the spoken digits during the voice check (and its backup)
VOICE_STT_MODEL=gemini-3.1-flash-lite
VOICE_STT_FALLBACK_MODEL=gemini-3.5-flash-lite

# Voice security. Set to 0 to switch voice checks off (emergency fallback for the demo).
VOICE_VERIFICATION_REQUIRED=1
# Strictest match cut-off a person's line may reach. Lines are always 0.40 or higher
# (measured: same person 0.42-0.66, a different person at most 0.35 on a shared laptop mic).
VOICE_THRESHOLD_CAP=0.45
# Demo mode: show "Voice match 65 (needs 45) · closest other voice 15" on the voice check.
VOICE_SHOW_SCORES=1
# If both speech services are unreachable, still let in a CLEARLY matching voice (1) or ask for the PIN (0).
VOICE_ALLOW_NO_STT=1

# Sarvam AI key for Indian-language speech (speech-to-text + voice replies). Get one at https://dashboard.sarvam.ai
# Without it the app still works: the browser's own speech is used instead.
SARVAM_API_KEY=

# Demo account shown on the log-in page ("Use the demo account").
DEMO_PHONE=9876543210
DEMO_PASSWORD=demo1234

# Price the bank sells digital gold at (Rs per gram, 24K). About 14,929 on 13 Oct 2026.
GOLD_PRICE_PER_GRAM=14929

# Speech-to-text services that check the spoken digits, run in parallel (first right answer wins)
VOICE_STT_ENGINES=sarvam,gemini
