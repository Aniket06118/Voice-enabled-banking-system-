# Copy this file to ".env" and fill it in. NEVER commit ".env" or share it publicly.

# Neon connection string (Neon dashboard -> Connect -> copy the connection string).
# Leave this line out entirely to use a local SQLite file instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

DJANGO_SECRET_KEY=change-me-to-any-long-random-text
DJANGO_DEBUG=1

# Gemini key for the voice agent (same key your friend uses in his .env,
# or make a free one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
AGENT_MODEL=gemini-2.5-flash

# Voice security. Set to 0 to switch voice checks off (emergency fallback for the demo).
VOICE_VERIFICATION_REQUIRED=1
# Strictest match cut-off the per-person threshold may reach (0.32-0.42 is a good range).
# NOTE: the old VOICE_MATCH_THRESHOLD line is no longer used - delete it from your .env.
VOICE_THRESHOLD_CAP=0.42
